{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "jsx": "react-native",
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "components",
    "screens",
    "contexts",
    "hooks",
    "utils",
    "services"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "artifacts",
    "web",
    "scripts"
  ]
}
