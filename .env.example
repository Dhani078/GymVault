# --- SUPABASE DATABASE & AUTHENTICATION ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# --- GOOGLE GEMINI AI CASCADE ---
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# --- DOKU OFFICIAL QRIS PAYMENT GATEWAY ---
DOKU_CLIENT_ID=your_doku_client_id_here
DOKU_SECRET_KEY=your_doku_secret_key_here
DOKU_API_KEY=your_doku_api_key_here
DOKU_API_HOST=https://api.doku.com

# --- TELEGRAM SAAS ADMIN BOT ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id_here
TELEGRAM_SECRET_TOKEN=your_telegram_webhook_secret_token_here

# --- INTERNAL WEBHOOK SECURITY ---
PAYMENT_WEBHOOK_SECRET=your_pre_shared_webhook_secret_here

# --- SECONDARY PAYMENT PROVIDERS ---
QIOSPAY_MERCHANT_CODE=your_qiospay_merchant_code_here
QIOSPAY_API_KEY=your_qiospay_api_key_here
