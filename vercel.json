{
  "version": 2,
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "/api/ads.txt"
    },
    {
      "source": "/((?!api/|ads\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
